# --- C++ / CMAKE ---
# Exclude all build directories except for the base folder if needed
build*/
# `build*/` also matches documentation directories whose name starts with "build"
# (e.g. skills/build-and-ci/). Keep those tracked.
!skills/build*-*/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
*.cmake
Makefile
*.ninja
*.o
*.a
*.lib
*.dylib
*.dll
make*.sh


# --- GATE / GEANT4 SPECIFIC ---
